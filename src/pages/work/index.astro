---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import blueBaguetteBand from '../../assets/editorial/archive/final-blue-baguette-band-mens-rose-gold-diamonds-hd.png';
import blueFloralSuite from '../../assets/editorial/archive/final-floral-diamond-suite-silver-sapphire-smooth-mono-hd.png';
import silverSerpentBracelet from '../../assets/editorial/archive/final-silver-serpent-bracelet-worn.png';
import geometricBracelet from '../../assets/editorial/archive/final-geometric-bracelet-worn.png';
import aquaDropEarrings from '../../assets/editorial/archive/final-aqua-drop-earrings-worn.png';
import petalPearlEarrings from '../../assets/editorial/archive/final-petal-pearl-earrings-worn.png';
import diamondLineSuite from '../../assets/editorial/archive/final-diamond-line-suite-worn.png';
import emeraldPendantSuite from '../../assets/editorial/archive/final-emerald-pendant-suite-worn.png';
import minimalDiamondPendant from '../../assets/editorial/archive/final-minimal-diamond-pendant-worn.png';
import architecturalHaloRing from '../../assets/editorial/archive/final-architectural-halo-ring-worn-emerald-diamonds.png';

const selectedOrder = [
  'stone-choker',
  'panther-bloom',
  'serpent-bangle',
  'rose-petal-suite',
  'blue-halo-ring',
  'emerald-tip-bracelet',
];

const selectedWork = (await getCollection('projects')).sort(
  (a, b) => selectedOrder.indexOf(a.id) - selectedOrder.indexOf(b.id),
);

const archive = [
  { title: 'Baguette Diamond Band', category: 'Ring', metal: 'Rose gold', image: blueBaguetteBand, alt: 'Rose-gold diamond baguette band worn by a male model' },
  { title: 'Sapphire Floral Suite', category: 'Necklace & earrings', metal: 'Silver', image: blueFloralSuite, alt: 'Silver floral diamond necklace and earrings with sapphire centre stones, worn on a model' },
  { title: 'Silver Serpent Bracelet', category: 'Bracelet', metal: 'Silver', image: silverSerpentBracelet, alt: 'Silver serpent bracelet worn on a model' },
  { title: 'Geometric Bracelet', category: 'Bracelet', metal: 'Rose gold', image: geometricBracelet, alt: 'Geometric bracelet worn on a model' },
  { title: 'Aqua Drop Earrings', category: 'Earrings', metal: 'Gold', image: aquaDropEarrings, alt: 'Aqua drop earrings worn on a model' },
  { title: 'Petal Pearl Earrings', category: 'Earrings', metal: 'Gold', image: petalPearlEarrings, alt: 'Petal pearl earrings worn on a model' },
  { title: 'Diamond Line Suite', category: 'Necklace & earrings', metal: 'Gold', image: diamondLineSuite, alt: 'Diamond necklace and earrings worn on a model' },
  { title: 'Emerald Pendant Suite', category: 'Necklace & earrings', metal: 'Gold', image: emeraldPendantSuite, alt: 'Emerald pendant necklace and earrings worn on a model' },
  { title: 'Minimal Diamond Pendant', category: 'Necklace', metal: 'Gold', image: minimalDiamondPendant, alt: 'Minimal diamond pendant worn on a model' },
  { title: 'Architectural Halo Ring', category: 'Rings', metal: 'Gold', image: architecturalHaloRing, alt: 'Gold architectural halo ring with an emerald center and diamond halo, worn on a model' },
];
---

<BaseLayout
  title="Jewellery Portfolio — Disha Jain"
  description="Jewellery CAD portfolio by Disha Jain, featuring six in-depth case studies and ten additional jewellery designs."
>
  <section class="section selected-section">
    <div class="container">
      <div class="section-head archive-head reveal">
        <p class="eyebrow">[ Jewellery portfolio / 2026 ]</p>
        <h1>Featured<br /><em>jewellery.</em></h1>
        <p>Six case studies that show each piece on the body and in close detail, alongside the decisions that shaped its form.</p>
      </div>
      <div class="project-grid">
        {
          selectedWork.map((project, index) => (
            <ProjectCard
              href={`/work/${project.id}/`}
              title={project.data.title}
              category={project.data.category === 'kada' ? "Men's open kada" : project.data.category}
              metal={project.data.metal}
              image={project.data.editorial}
              alt={`${project.data.title} worn by a model`}
              orientation={project.data.orientation}
              index={index}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section archive-section">
    <div class="container">
      <div class="section-head archive-head archive-copy reveal">
        <p class="eyebrow">[ Additional designs / 10 pieces ]</p>
        <h2>More <em>jewellery.</em></h2>
        <p>Ten further pieces across rings, necklaces, bracelets, earrings and coordinated sets. Each is presented for an immediate read of form, scale and material.</p>
      </div>
      <div class="project-grid">
        {
          archive.map((project, index) => (
            <ProjectCard {...project} index={selectedWork.length + index} headingLevel={3} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-top: clamp(5rem, 11vw, 9rem); }
  .selected-section { padding-bottom: clamp(6rem, 11vw, 10rem); }
  .archive-section { padding-bottom: clamp(6rem, 11vw, 10rem); border-top: 1px solid var(--line); background: var(--surface); }

  .archive-head { max-width: 52rem; margin-bottom: clamp(3rem, 7vw, 6rem); }

  .section-head h1,
  .section-head h2 {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 540;
    line-height: .86;
    letter-spacing: -.075em;
    margin-top: 1rem;
  }

  .section-head p:not(.eyebrow) { max-width: 43rem; margin-top: 1.6rem; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.6; }
  em { font-family: var(--font-serif); font-weight: 400; }

  .project-grid { display: grid; gap: clamp(1rem, 2.5vw, 2.5rem); }

  @media (min-width: 760px) {
    .project-grid { grid-template-columns: repeat(2, 1fr); }
    .project-grid > :global(:nth-child(even)) { margin-top: 3rem; }
  }
</style>
