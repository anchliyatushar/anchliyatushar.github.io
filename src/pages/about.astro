---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';

const tools = [
  'Rhino 3D',
  'Matrix 9',
  'MatrixGold',
  'Jewellery visualisation',
  '3D printing workflows',
  'Technical CAD support',
];

const focus = [
  'Sketch-to-CAD development',
  'Jewellery design interpretation',
  'Production-oriented modelling',
  'CAD mentoring and technical guidance',
];

const services = [
  {
    title: 'Jewellery CAD development',
    body: 'From a sketch, reference or stone plan to an accurate 3D model, with proportion, setting and production requirements considered throughout.',
  },
  {
    title: 'Jewellery visualisation',
    body: 'On-model and close-detail imagery that clarifies scale, material and design intent before a piece is made.',
  },
  {
    title: 'Training and technical guidance',
    body: 'Practical CAD mentoring, workflow guidance and production-aware troubleshooting for jewellery teams and learners.',
  },
];
---

<BaseLayout
  title="About Disha Jain — Jewellery CAD Designer"
  description="Meet Disha Jain, a jewellery CAD designer, educator and technical consultant working in Rhino, Matrix 9 and MatrixGold."
>
  <section class="section">
    <div class="container about">
      <div class="intro reveal">
        <p class="eyebrow">[ About Disha ]</p>
        <h1>Jewellery ideas,<br />made precise in 3D.</h1>
        <p>
          Disha Jain is a jewellery CAD designer, CAD faculty member and technical consultant with 3.5 years of experience in jewellery design, 3D modelling, rendering and production support.
        </p>
        <p>
          Her practice moves between design interpretation, CAD development and manufacturing-oriented workflows, with a particular interest in new methods of jewellery visualisation.
        </p>
        <div class="download-actions">
          <a class="btn btn-primary" href="/resume.pdf" download>Download resume <ArrowIcon direction="down" /></a>
          <a class="btn btn-ghost" href="/disha-jain-jewellery-cad-portfolio.pdf" download>Download portfolio PDF <ArrowIcon direction="down" /></a>
        </div>
      </div>

      <div class="side">
        <div class="list-block reveal reveal-delay-1">
          <h2>Focus</h2>
          <ul>
            {focus.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="list-block reveal reveal-delay-2">
          <h2>Tools</h2>
          <ul>
            {tools.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">[ Services ]</p>
        <h2>What I offer</h2>
      </div>
      <div class="services">
        {
          services.map((s, i) => (
            <div class:list={['service', 'reveal', `reveal-delay-${i + 1}`]}>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 3rem;
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    margin: 0.5rem 0 1.25rem;
    max-width: 16ch;
  }

  .intro p {
    color: var(--muted);
    font-size: 1.08rem;
    max-width: 38rem;
  }

  .intro p + p {
    margin-top: 1rem;
  }

  .download-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .download-actions .btn {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .side {
    display: grid;
    gap: 2rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  h2 {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  li {
    color: var(--muted);
    font-size: 1.02rem;
  }

  .services-section {
    padding-top: 0;
  }

  .services {
    display: grid;
    gap: 1.5rem;
  }

  .service {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .service h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .service p {
    color: var(--muted);
    max-width: 36rem;
  }

  @media (min-width: 800px) {
    .about {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
      align-items: start;
    }

    .side {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 2.5rem;
    }

    .services {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>
