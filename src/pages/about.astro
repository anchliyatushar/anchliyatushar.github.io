---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  'Rhino 3D',
  'Matrix 9',
  'MatrixGold',
  'AI-assisted modelling & rendering',
  '3D printing workflows',
  'CAD / production troubleshooting',
];

const focus = [
  'CAD development from sketches',
  'Jewellery design interpretation',
  'Production-oriented modelling',
  'Practical CAD education & mentoring',
];

const services = [
  {
    title: 'Jewellery CAD',
    body: 'Detailed 2D and 3D jewellery models developed from sketches, concepts, specifications and product requirements.',
  },
  {
    title: 'Visualisation & R&D',
    body: 'Jewellery renders, concept exploration and AI-assisted visualisation workflows for clearer design decisions.',
  },
  {
    title: 'Training & technical support',
    body: 'Industry-oriented CAD learning, technical guidance and production-aware troubleshooting for jewellery workflows.',
  },
];
---

<BaseLayout
  title="About — Disha"
  description="About Disha Jain — jewellery CAD designer, faculty and technical consultant working in Rhino, Matrix and MatrixGold."
>
  <section class="section">
    <div class="container about">
      <div class="intro reveal">
        <p class="eyebrow">About</p>
        <h1>Craft in the curve. Logic in the model.</h1>
        <p>
          Disha Jain is a jewellery CAD designer, CAD faculty member and technical consultant with 3.5 years of experience in jewellery design, 3D modelling, rendering and production support.
        </p>
        <p>
          Her practice moves between design interpretation, CAD development and manufacturing-oriented workflows - with a particular interest in AI-assisted modelling, rendering and the next generation of jewellery visualisation.
        </p>
        <a class="btn btn-primary resume" href="/resume.pdf">Download resume</a>
      </div>

      <div class="side">
        <div class="list-block reveal reveal-delay-1">
          <h2>Focus</h2>
          <ul>
            {focus.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="list-block reveal reveal-delay-2">
          <h2>Tools</h2>
          <ul>
            {tools.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Services</p>
        <h2>How we work</h2>
      </div>
      <div class="services">
        {
          services.map((s, i) => (
            <div class:list={['service', 'reveal', `reveal-delay-${i + 1}`]}>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 3rem;
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    margin: 0.5rem 0 1.25rem;
    max-width: 16ch;
  }

  .intro p {
    color: var(--muted);
    font-size: 1.08rem;
    max-width: 38rem;
  }

  .intro p + p {
    margin-top: 1rem;
  }

  .resume {
    margin-top: 1.75rem;
  }

  .side {
    display: grid;
    gap: 2rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  h2 {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  li {
    color: var(--muted);
    font-size: 1.02rem;
  }

  .services-section {
    padding-top: 0;
  }

  .services {
    display: grid;
    gap: 1.5rem;
  }

  .service {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .service h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .service p {
    color: var(--muted);
    max-width: 36rem;
  }

  @media (min-width: 800px) {
    .about {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
      align-items: start;
    }

    .side {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 2.5rem;
    }

    .services {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>
