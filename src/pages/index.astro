---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PantherBloomTransformation from '../components/PantherBloomTransformation.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import stoneChokerDetail from '../assets/editorial/final/final-stone-choker-detail.png';
import pantherBloomDetail from '../assets/editorial/final/final-panther-bloom-male-detail.png';
import serpentBangleDetail from '../assets/editorial/final/final-serpent-bangle-mens-detail-extreme-macro-left.png';
import rosePetalSuite from '../assets/editorial/final/final-rose-petal-suite-model-retouched-detail.png';
import blueHaloRingDetail from '../assets/editorial/final/final-ruby-halo-ring-detail-ruby.png';
import emeraldTipBraceletDetail from '../assets/editorial/final/final-emerald-tip-bracelet-detail.png';

const projects = [
  {
    id: '01', spotlight: stoneChokerDetail, spotlightAlt: 'Emerald Stone Choker detail', type: 'Emerald Stone Choker · Necklace',
    title: 'Colour held close to the collarbone.',
    href: '/work/stone-choker/', position: '50% 50%',
  },
  {
    id: '02', spotlight: pantherBloomDetail, spotlightAlt: 'Panther Bloom Brooch detail', type: 'Panther Bloom Brooch · Statement brooch',
    title: 'Wild form. Precise detail.',
    href: '/work/panther-bloom/', position: '50% 50%',
  },
  {
    id: '03', spotlight: serpentBangleDetail, spotlightAlt: 'Sculptural Serpent Kada detail', type: "Sculptural Serpent Kada · Men's open kada",
    title: 'Two profiles. One gesture.',
    href: '/work/serpent-bangle/', position: '50% 50%',
  },
  {
    id: '04', spotlight: rosePetalSuite, spotlightAlt: 'Rose Petal Bridal Suite worn on a model', type: 'Rose Petal Bridal Suite · Necklace and earrings',
    title: 'A floral rhythm in blush.',
    href: '/work/rose-petal-suite/', position: '50% 50%',
  },
  {
    id: '05', spotlight: blueHaloRingDetail, spotlightAlt: 'Ruby Halo Ring detail', type: 'Ruby Halo Ring · Ring',
    title: 'Built around a ruby centre.',
    href: '/work/blue-halo-ring/', position: '50% 50%',
  },
  {
    id: '06', spotlight: emeraldTipBraceletDetail, spotlightAlt: 'Emerald Tip Bracelet detail', type: 'Emerald Tip Bracelet · Open bracelet',
    title: 'A quiet line with green at each end.',
    href: '/work/emerald-tip-bracelet/', position: '50% 50%',
  },
];

const capabilities = [
  ['01', 'Interpret', 'Sketches, stone plans and references become a clear CAD brief.'],
  ['02', 'Model', 'Rhino, Matrix 9 and MatrixGold turn the concept into accurate 3D geometry.'],
  ['03', 'Refine', 'Proportion, stone settings, wall thickness and joins are resolved with wearability and manufacture in mind.'],
  ['04', 'Visualise', 'On-body and close-detail imagery makes scale, material and craftsmanship easy to judge.'],
];
---

<BaseLayout title="Disha Jain — Jewellery CAD Designer" description="Jewellery CAD portfolio of Disha Jain, specialising in 3D modelling, visualisation and production-aware jewellery development.">
  <section class="hero" data-hero>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker"><span class="status-dot"></span> Jewellery CAD designer · Bangalore, India</p>
        <h1>Jewellery,<br /><em>made build-ready.</em></h1>
        <p class="hero-intro">From sketch and stone plan to a considered 3D model—resolved for proportion, wearability and craft.</p>
        <div class="hero-actions">
          <a href="#featured-projects" class="button button-gold">Explore the portfolio <ArrowIcon direction="down" /></a>
          <a href="/contact/" class="text-link">Start a project <ArrowIcon /></a>
        </div>
      </div>

      <div class="hero-viewport">
        <PantherBloomTransformation />
      </div>
    </div>
    <div class="hero-bottom container"><p>Scroll to explore</p><div class="hero-rule"><span></span></div><p>Jewellery portfolio</p></div>
  </section>

  <section class="about-process section" aria-labelledby="about-process-heading">
    <div class="container">
      <div class="about-process-intro">
        <p class="section-label">[ About Disha ]</p>
        <div class="statement-copy reveal">
          <h2 id="about-process-heading" class="statement-large">Creative intent.<br /><em>Production precision.</em></h2>
          <p>Disha Jain is a jewellery CAD designer, educator and technical consultant with 3.5 years of experience in 3D modelling, visualisation and production support. Her process turns sketches and specifications into precise jewellery models made with manufacture in mind.</p>
          <a class="portfolio-download" href="/disha-jain-jewellery-cad-portfolio.pdf" download>Download selected work PDF <ArrowIcon direction="down" /></a>
        </div>
      </div>

      <div class="process-block" aria-label="Design process">
        <div class="process-header reveal">
          <p class="section-label">[ Process / 01—04 ]</p>
          <p class="process-summary">From brief to <em>build-ready.</em></p>
        </div>
        <div class="capability-grid">
          {capabilities.map(([number, title, body], index) => (
            <article class:list={['capability', 'reveal', `reveal-delay-${(index % 3) + 1}`]}>
              <span class="capability-number">{number}</span><h3>{title}</h3><p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="work-intro" id="featured-projects">
    <div class="container work-intro-grid">
      <p class="section-label">[ Portfolio highlights ]</p>
      <div class="work-intro-copy">
        <h2>Featured<br /><em>projects.</em></h2>
        <p>Explore six jewellery case studies through the concept, 3D construction choices, materials and final worn and close-detail views.</p>
        <span class="work-count">06 CASE STUDIES</span>
      </div>
    </div>
  </section>

  <div class="project-journey" aria-label="Featured jewellery case studies">
    {projects.map((project, index) => (
      <section
        class:list={['project-chapter', { 'image-left': index % 2 === 1 }]}
        data-project-chapter
        aria-labelledby={`project-${project.id}`}
      >
        <div class="project-stage">
          <div class="project-render">
            <Image src={project.spotlight} alt={project.spotlightAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 780px) 64vw, 100vw" loading={index === 0 ? 'eager' : 'lazy'} style={`object-position:${project.position}`} />
          </div>
          <div class="project-content">
            <div class="project-index"><span>{project.id}</span><i></i><span>{String(projects.length).padStart(2, '0')}</span></div>
            <div class="project-copy">
              <p class="project-type">{project.type}</p><h2 id={`project-${project.id}`}>{project.title}</h2>
              <a href={project.href} class="button button-outline">Open case study <ArrowIcon /></a>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="tools-section section">
    <div class="container tools-grid"><p class="section-label">[ Methods and tools ]</p><div class="tools-content reveal"><h2>Digital modelling.<br /><em>Jewellery thinking.</em></h2><div class="tool-list"><span>Rhino 3D</span><span>Matrix 9</span><span>MatrixGold</span><span>Jewellery visualisation</span><span>3D printing</span><span>AI-assisted visual development</span></div></div></div>
  </section>

  <section class="contact-cta"><div class="container contact-cta-inner reveal"><p class="section-label">[ Available for jewellery projects ]</p><h2>Have a piece<br />in <em>mind?</em></h2><a href="/contact/" class="contact-round-link" aria-label="Contact Disha Jain"><span>LET'S<br />TALK</span><ArrowIcon class="contact-arrow" /></a></div></section>
</BaseLayout>

<style>
  .hero { position: relative; min-height: calc(100svh - var(--header-h)); overflow: clip; padding: clamp(3rem, 6vw, 5rem) 0 1.7rem; }
  .hero::before { content: ''; position: absolute; z-index: -1; width: min(64vw, 59rem); aspect-ratio: 1; top: -27rem; right: -12rem; border: 1px solid rgba(193, 232, 244, .08); border-radius: 50%; box-shadow: 0 0 0 5rem rgba(193, 232, 244, .025), 0 0 0 10rem rgba(193, 232, 244, .014); }
  .hero-grid { display: grid; align-items: center; min-height: min(44rem, calc(100svh - var(--header-h) - 7rem)); gap: clamp(2.5rem, 5vw, 7rem); }
  .hero-copy { position: relative; z-index: 2; max-width: 39rem; padding: 2rem 0; }
  .kicker, .section-label, .project-type { font: 600 clamp(.62rem, .8vw, .72rem)/1.2 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; color: var(--blue-pale); }
  .kicker { display: flex; align-items: center; gap: .65rem; color: var(--muted); }.status-dot { display: inline-block; width: .45rem; height: .45rem; border-radius: 50%; background: var(--signal); box-shadow: 0 0 1rem var(--signal); }
  h1 { max-width: 9ch; margin: 1.65rem 0 1.8rem; font-size: clamp(4rem, 7vw, 8.4rem); font-weight: 560; line-height: .88; letter-spacing: -.075em; }em { font-family: var(--font-serif); font-weight: 400; letter-spacing: -.06em; }
  .hero-intro { max-width: 30rem; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.18rem); line-height: 1.7; }.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem 2rem; margin-top: 2rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 2rem; min-height: 3.2rem; padding: .75rem 1rem .75rem 1.25rem; font: 600 .7rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; transition: transform .25s var(--ease), background-color .25s var(--ease), color .25s var(--ease), border-color .25s var(--ease); }.button:hover { transform: translateY(-3px); }.button-gold { color: #0a0a08; background: var(--gold); border: 1px solid var(--gold); }.button-gold:hover { background: var(--gold-bright); border-color: var(--gold-bright); }
  .text-link { display: inline-flex; gap: .75rem; align-items: center; color: var(--text); font-size: .9rem; border-bottom: 1px solid var(--line-strong); padding-bottom: .3rem; transition: color .25s var(--ease), border-color .25s var(--ease); }.text-link:hover { color: var(--gold-bright); border-color: var(--gold); }
  .hero-viewport { position: relative; justify-self: center; width: min(100%, 39rem); transform: translateZ(0); }
  .hero-bottom { display: flex; align-items: center; gap: 1rem; color: var(--muted); font: 500 .58rem/1 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }.hero-rule { position: relative; flex: 1; height: 1px; background: var(--line); overflow: hidden; }.hero-rule span { display: block; width: 25%; height: 100%; background: var(--gold); animation: scan 4s ease-in-out infinite; }@keyframes scan { 50% { transform: translateX(280%); } }
  .about-process { border-top: 1px solid var(--line); padding-block: clamp(6rem, 10vw, 9rem); }.tools-grid { display: grid; gap: 2rem; }.about-process-intro, .process-header { display: grid; gap: 2rem; align-items: start; }.statement-copy { max-width: 58rem; }.statement-large { max-width: 13ch; font-family: var(--font-display); font-size: clamp(2.3rem, 4.5vw, 4.85rem); font-weight: 540; letter-spacing: -.065em; line-height: .96; }.statement-copy > p:last-child { max-width: 37rem; margin-top: 2rem; color: var(--muted); font-size: 1.05rem; }.portfolio-download { display: inline-flex; align-items: center; gap: .65rem; min-height: 2.8rem; margin-top: 1.35rem; padding: .7rem .9rem; border: 1px solid var(--line-strong); color: var(--text); font: 600 .68rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; transition: border-color .25s var(--ease), color .25s var(--ease), background-color .25s var(--ease), transform .25s var(--ease); }.portfolio-download:hover { color: #0a0a08; border-color: var(--gold); background: var(--gold); transform: translateY(-2px); }.process-block { margin-top: clamp(2.5rem, 4vw, 3.75rem); }.process-header { margin-bottom: 1.1rem; }.process-summary { max-width: 34rem; color: var(--text); font-family: var(--font-display); font-size: clamp(1.2rem, 1.8vw, 1.7rem); font-weight: 540; letter-spacing: -.045em; line-height: 1.08; }.work-intro h2, .tools-content h2, .contact-cta h2 { font-size: clamp(3rem, 6vw, 6.25rem); font-weight: 530; letter-spacing: -.07em; line-height: .9; }.capability-grid { display: grid; border-top: 1px solid var(--line); }.capability { position: relative; min-height: 17rem; padding: 1.2rem; border-bottom: 1px solid var(--line); overflow: hidden; transition: background-color .35s var(--ease), color .35s var(--ease); }.capability::before { content: ''; position: absolute; inset: auto 0 0; height: 0; background: var(--gold); transition: height .35s var(--ease); }.capability:hover { color: #0a0a08; }.capability:hover::before { height: 100%; }.capability > * { position: relative; z-index: 1; }.capability-number { color: var(--gold); font: 500 .64rem/1 var(--font-mono); letter-spacing: .1em; }.capability h3 { margin-top: clamp(3rem, 6vw, 6.5rem); font-size: clamp(1.6rem, 2.2vw, 2.25rem); font-weight: 550; letter-spacing: -.05em; }.capability p { max-width: 24rem; margin-top: .8rem; color: var(--muted); font-size: .93rem; transition: color .35s var(--ease); }.capability:hover p, .capability:hover .capability-number { color: #3b2c0b; }
  .work-intro { padding: clamp(5.5rem, 10vw, 8.5rem) 0 clamp(2.5rem, 4vw, 4rem); background: var(--surface); border-top: 1px solid var(--line); }.work-intro-grid { display: grid; gap: 2rem; align-items: start; }.work-intro h2 { max-width: 12ch; margin-bottom: 1.3rem; font-size: clamp(2.3rem, 4.5vw, 4.85rem); }.work-intro-copy > p { max-width: 34rem; color: var(--muted); }.work-count { display: inline-flex; margin-top: 1.5rem; color: var(--gold); font: 600 .65rem/1 var(--font-mono); letter-spacing: .14em; white-space: nowrap; }
  .project-chapter { height: 125svh; position: relative; --chapter-progress: 0; }
  .project-stage { position: sticky; top: var(--header-h); display: grid; grid-template-columns: minmax(20rem, .66fr) minmax(0, 1.34fr); height: calc(100svh - var(--header-h)); overflow: hidden; background: #050504; isolation: isolate; }
  .project-render { grid-column: 2; grid-row: 1; overflow: hidden; background: #101211; }
  .project-render :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; transform: scale(calc(1.035 - var(--chapter-progress) * .035)); transition: transform .3s var(--ease); }
  .project-content { z-index: 1; display: flex; grid-column: 1; grid-row: 1; flex-direction: column; justify-content: space-between; min-width: 0; padding: clamp(2rem, 4.25vw, 4.5rem) clamp(1.5rem, 3.5vw, 4rem); background: #070908; }
  .project-index { display: flex; align-items: center; gap: .6rem; font: 500 .65rem/1 var(--font-mono); letter-spacing: .12em; color: var(--gold); }.project-index i { width: 3.5rem; height: 1px; background: var(--gold); }
  .project-copy { max-width: 29rem; transform: translateY(calc((1 - var(--chapter-progress)) * 1.1rem)); opacity: calc(.78 + var(--chapter-progress) * .22); transition: transform .3s var(--ease), opacity .3s var(--ease); }.project-type { margin-bottom: .85rem; color: var(--blue-pale); }.project-copy h2 { max-width: 9ch; font-size: clamp(2.7rem, 4.7vw, 5.35rem); font-weight: 540; letter-spacing: -.07em; line-height: .9; }
  .button-outline { color: var(--text); border: 1px solid rgba(237, 217, 156, .55); background: transparent; }.button-outline:hover { color: #0a0a08; border-color: var(--gold); background: var(--gold); }
  .tools-section { padding-block: clamp(7rem, 13vw, 11rem); }.tools-content h2 { max-width: 13ch; }.tool-list { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 2.2rem; }.tool-list span { border: 1px solid var(--line-strong); padding: .65rem .8rem; color: var(--muted); font: 500 .68rem/1.2 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; transition: color .2s var(--ease), border-color .2s var(--ease); }.tool-list span:hover { color: var(--gold-bright); border-color: var(--gold); }
  .contact-cta { margin-top: 0; padding: clamp(5rem, 10vw, 10rem) 0; background: var(--gold); color: #0b0a06; overflow: hidden; }.contact-cta-inner { position: relative; min-height: 18rem; }.contact-cta .section-label { color: rgba(20,15,4,.7); }.contact-cta h2 { max-width: 10ch; margin-top: 2rem; }.contact-round-link { position: absolute; right: 1%; bottom: 0; display: grid; place-items: center; width: clamp(8.5rem, 14vw, 12rem); aspect-ratio: 1; border: 1px solid rgba(16,12,3,.55); border-radius: 50%; text-align: center; font: 600 .7rem/1.4 var(--font-mono); letter-spacing: .12em; transition: transform .3s var(--ease), color .3s var(--ease), background .3s var(--ease); }.contact-round-link :global(.contact-arrow) { position: absolute; width: .75rem; height: .75rem; top: 21%; right: 21%; }.contact-round-link:hover { color: var(--gold); background: #0a0a08; transform: rotate(8deg); }
  @media (min-width: 780px) { .hero-grid { grid-template-columns: minmax(0, .9fr) minmax(25rem, 1.1fr); }.hero-viewport { width: min(100%, 43rem); }.about-process-intro, .process-header, .tools-grid, .work-intro-grid { grid-template-columns: minmax(11rem, .5fr) minmax(0, 1.5fr); }.capability-grid { grid-template-columns: repeat(4, 1fr); }.capability { border-right: 1px solid var(--line); }.capability:last-child { border-right: 0; }.project-chapter.image-left .project-stage { grid-template-columns: minmax(0, 1.34fr) minmax(20rem, .66fr); }.project-chapter.image-left .project-render { grid-column: 1; }.project-chapter.image-left .project-content { grid-column: 2; } }
  @media (max-width: 779px) {
    .hero { padding-top: 2rem; }.hero-grid { min-height: auto; }.hero-copy { padding-bottom: 0; }h1 { font-size: clamp(4.2rem, 17vw, 6.3rem); }.hero-viewport { order: -1; margin-inline: auto; width: min(100%, 30rem); }.hero-bottom { margin-top: 2rem; }.hero-bottom p:last-child { display: none; }.process-summary { margin-top: .25rem; }.capability { min-height: 12rem; }.capability h3 { margin-top: 2.4rem; }
    .work-intro { padding: 4.75rem 0 2.5rem; }.project-chapter { height: auto; }.project-stage { position: relative; top: auto; display: flex; height: auto; flex-direction: column; }.project-render { height: min(58svh, 34rem); }.project-render :global(img) { transform: none; object-position: center !important; }.project-content { display: block; padding: 1.5rem clamp(1.25rem, 5vw, 2rem) 2.75rem; }.project-index { margin-bottom: 1.8rem; }.project-copy { transform: none; opacity: 1; }.project-copy h2 { max-width: 9ch; font-size: clamp(2.7rem, 11.8vw, 4.4rem); }.project-copy .button { margin-top: .25rem; }
    .contact-cta-inner { min-height: 25rem; }.contact-round-link { right: 0; bottom: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-rule span { animation: none; }.project-render, .project-copy { transform: none; transition: none; }.button:hover, .contact-round-link:hover { transform: none; } }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-project-chapter]'));
  if (!reduceMotion && chapters.length) {
    let scheduled = false;
    const updateScroll = () => { const viewport = window.innerHeight; chapters.forEach((chapter) => { const bounds = chapter.getBoundingClientRect(); if (bounds.bottom < 0 || bounds.top > viewport) return; const distance = Math.max(1, bounds.height - viewport); const progress = Math.max(0, Math.min(1, -bounds.top / distance)); chapter.style.setProperty('--chapter-progress', progress.toFixed(3)); }); scheduled = false; };
    const schedule = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(updateScroll); } };
    addEventListener('scroll', schedule, { passive: true }); addEventListener('resize', schedule, { passive: true }); updateScroll();
  }
</script>
