<style>
  .cad-scene {
    --mouse-x: 0deg;
    --mouse-y: 0deg;
    position: relative;
    width: min(100%, 43rem);
    aspect-ratio: 1 / 1;
    perspective: 1200px;
    perspective-origin: 52% 45%;
    overflow: hidden;
    border: 1px solid rgba(214, 238, 246, .22);
    border-radius: .35rem;
    background:
      radial-gradient(circle at 50% 43%, rgba(199, 235, 246, .13), transparent 24%),
      linear-gradient(135deg, #0b1114 0%, #050708 68%);
    box-shadow: inset 0 0 100px rgba(0, 0, 0, .4), 0 20px 80px rgba(0, 0, 0, .3);
    isolation: isolate;
  }

  .cad-scene::before,
  .cad-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cad-scene::before {
    z-index: 5;
    opacity: .2;
    background-image: linear-gradient(rgba(207, 240, 246, .2) 1px, transparent 1px), linear-gradient(90deg, rgba(207, 240, 246, .2) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    mask-image: linear-gradient(130deg, black, transparent 76%);
  }

  .cad-scene::after {
    z-index: 6;
    opacity: .4;
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,.025) 3px 4px);
  }

  .cad-floor {
    position: absolute;
    width: 115%;
    height: 52%;
    left: -7%;
    bottom: -20%;
    transform: rotateX(66deg);
    transform-origin: center top;
    background-image: linear-gradient(rgba(183, 236, 249, .25) 1px, transparent 1px), linear-gradient(90deg, rgba(183, 236, 249, .25) 1px, transparent 1px);
    background-size: 2rem 2rem;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,.85), transparent);
  }

  .cad-backplane {
    position: absolute;
    z-index: -1;
    inset: 20% 12%;
    border: 1px solid rgba(193, 235, 248, .25);
    transform: rotateX(12deg) rotateY(-11deg);
  }

  .cad-axes { position: absolute; z-index: 3; width: 6.25rem; height: 1px; background: rgba(138, 231, 253, .62); transform-origin: left center; }
  .cad-axes span { position: absolute; right: -1.1rem; top: -1.25rem; font: 600 .62rem/1 var(--font-mono); color: #bfeefe; }
  .cad-axes-x { left: 9%; bottom: 11%; transform: rotate(-11deg); }
  .cad-axes-y { left: 9%; bottom: 11%; transform: rotate(-78deg); }
  .cad-axes-z { left: 9%; bottom: 11%; transform: rotate(41deg); background: rgba(244, 209, 112, .7); }

  .cad-float { position: absolute; z-index: 2; inset: 8%; transform-style: preserve-3d; animation: drift 5.5s ease-in-out infinite; }
  .cad-rotation { width: 100%; height: 100%; transform-style: preserve-3d; transform: rotateX(calc(-8deg + var(--mouse-y))) rotateY(calc(17deg + var(--mouse-x))); transition: transform .35s var(--ease); }
  .cad-model { width: 100%; height: 100%; overflow: visible; transform: translateZ(30px); }
  .construction { transform-origin: center; animation: model-spin 24s linear infinite; }
  .ring-body { transform-origin: center; animation: glint 5s ease-in-out infinite; }
  .cad-labels { font: 600 11px var(--font-mono); letter-spacing: 1.2px; }
  .view-label { position: absolute; z-index: 7; font: 600 .58rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: rgba(219, 244, 250, .65); }
  .view-label-top { top: 1.2rem; left: 1.2rem; }
  .view-label-bottom { right: 1.2rem; bottom: 1.2rem; color: rgba(246, 211, 111, .75); }

  @keyframes drift { 50% { transform: translateY(-.85rem); } }
  @keyframes model-spin { to { transform: rotate(360deg); } }
  @keyframes glint { 50% { filter: brightness(1.2); } }
  @media (prefers-reduced-motion: reduce) { .cad-float, .construction, .ring-body { animation: none; } .cad-rotation { transition: none; } }
