---
interface Props {
  direction?: 'up-right' | 'down' | 'left';
  class?: string;
}

const { direction = 'up-right', class: className } = Astro.props;
---

<svg
  class:list={['icon-arrow', className]}
  viewBox="0 0 16 16"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.55"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
>
  {
    direction === 'down' ? (
      <>
        <path d="M8 2.25v11.5" />
        <path d="m3.5 9.25 4.5 4.5 4.5-4.5" />
      </>
    ) : direction === 'left' ? (
      <>
        <path d="M13.75 8h-11.5" />
        <path d="m6.75 2.75-4.5 5.25 4.5 5.25" />
      </>
    ) : (
      <>
        <path d="M2.5 13.5 13.5 2.5" />
        <path d="M6.25 2.5h7.25v7.25" />
      </>
    )
  }
</svg>

<style>
  .icon-arrow {
    display: block;
    flex: none;
    overflow: visible;
  }
</style>
