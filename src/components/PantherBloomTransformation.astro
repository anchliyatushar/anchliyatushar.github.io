---
import { Image } from 'astro:assets';
import poster from '../assets/generated/panther-bloom-opening-gold.png';
---

<figure class="panther-transformation" data-panther-study aria-labelledby="panther-title">
  <div class="panther-poster" data-panther-poster>
    <Image src={poster} alt="Panther Bloom Brooch in polished gold with blue stones and black eyes" width={1000} format="webp" quality={90} loading="eager" fetchpriority="high" />
  </div>
  <div class="panther-canvas" data-panther-canvas role="img" aria-hidden="true" aria-label="A three-dimensional study of Panther Bloom Brooch, revealing its construction and returning to polished gold and blue stones."></div>
  <figcaption class="panther-heading">
    <span>Behind the piece</span>
    <strong id="panther-title">Panther Bloom</strong>
  </figcaption>
  <div class="panther-footer">
    <div class="panther-chapter" aria-live="off">
      <span class="panther-chapter-index" data-panther-number>01</span>
      <span data-panther-caption>Form &amp; finish</span>
    </div>
    <button class="panther-playback" data-panther-pause data-paused="false" type="button" aria-label="Pause brooch animation" disabled>
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
        <g class="pause-icon"><path d="M7 5v10M13 5v10" /></g>
        <g class="play-icon"><path d="m7 4 8 6-8 6Z" /></g>
      </svg>
    </button>
  </div>
  <div class="panther-progress" aria-hidden="true"><span data-panther-progress></span></div>
</figure>

<script>
  import { mountPantherStudy } from '../scripts/panther-scene';
  document.querySelectorAll<HTMLElement>('[data-panther-study]').forEach(mountPantherStudy);
</script>

<style>
  .panther-transformation {
    position: relative;
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(218, 200, 156, .15);
    border-radius: .4rem;
    background: radial-gradient(ellipse at 48% 42%, #19201d, #0c100e 42%, #070908 78%);
  }
  .panther-canvas, .panther-poster { position: absolute; inset: 0; }
  .panther-canvas { opacity: 0; transition: opacity .25s ease; }
  .panther-canvas :global(canvas) { display: block; width: 100%; height: 100%; }
  .panther-poster { transition: opacity .25s ease, visibility .25s; }
  .panther-poster img { display: block; width: 100%; height: 100%; object-fit: contain; }
  [data-ready] .panther-canvas { opacity: 1; }
  [data-ready] .panther-poster { opacity: 0; visibility: hidden; }
  .panther-heading { position: absolute; z-index: 2; top: 1.45rem; left: 1.55rem; display: grid; gap: .4rem; pointer-events: none; }
  .panther-heading span { font: .57rem/1.4 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; color: #9da89f; }
  .panther-heading strong { font: 500 clamp(1rem, 1.6vw, 1.3rem)/1.2 var(--font-display); color: #e8e4d9; }
  .panther-footer { position: absolute; z-index: 2; bottom: 1rem; left: 1.55rem; right: 1rem; display: flex; align-items: center; justify-content: space-between; }
  .panther-chapter { display: flex; align-items: center; gap: .75rem; color: #b7c2bb; font: .61rem/1.4 var(--font-mono); letter-spacing: .045em; }
  .panther-chapter-index { color: #d6b654; }
  .panther-playback { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid rgba(214, 182, 84, .22); border-radius: 50%; background: rgba(7, 9, 8, .55); color: #d6b654; cursor: pointer; }
  .panther-playback:hover { background: #24281f; }
  .panther-playback:focus-visible { outline: 2px solid #d6b654; outline-offset: 4px; }
  .panther-playback:disabled { visibility: hidden; }
  .panther-playback svg { fill: none; stroke: currentColor; stroke-width: 1.3; }
  .play-icon, [data-paused="true"] .pause-icon { display: none; }
  [data-paused="true"] .play-icon { display: block; }
  .panther-progress { position: absolute; bottom: 0; left: 0; right: 0; height: 1px; }
  .panther-progress span { display: block; width: 100%; height: 100%; background: #d6b654; transform: scaleX(0); transform-origin: left; }
  @media (max-width: 600px) {
    .panther-heading { top: 1rem; left: 1rem; }
    .panther-footer { bottom: .7rem; left: 1rem; right: .7rem; }
    .panther-chapter { font-size: .56rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .panther-canvas, .panther-poster { transition: none; }
    .panther-progress { display: none; }
  }
</style>
