---
const pathname = Astro.url.pathname;

const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/work/') return pathname.startsWith('/work');
  return pathname === href || pathname === href.replace(/\/$/, '');
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Disha Jain home">
      <span class="brand-name">Disha Jain</span>
      <span class="brand-role">Jewellery CAD</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid var(--line);
    background: rgba(7, 9, 8, 0.78);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.045em;
  }

  .brand-name {
    font-size: 1.08rem;
  }

  .brand-role {
    color: var(--gold);
    font: 600 0.56rem/1 var(--font-mono);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .nav-link {
    font: 500 0.68rem/1 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link.active {
    box-shadow: inset 0 -1px 0 var(--gold);
  }

  @media (max-width: 480px) {
    .brand-role { display: none; }
  }
</style>
