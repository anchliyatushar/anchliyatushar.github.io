---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href?: string;
  title: string;
  category: string;
  metal?: string;
  image: ImageMetadata;
  alt?: string;
  orientation?: 'portrait' | 'landscape';
  index?: number;
  headingLevel?: 2 | 3;
}

const {
  href,
  title,
  category,
  metal,
  image,
  alt = `${title} editorial image`,
  orientation = 'portrait',
  index = 0,
  headingLevel = 2,
} = Astro.props;
const delayClass = `reveal-delay-${(index % 3) + 1}`;
const Tag = href ? 'a' : 'article';
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<Tag class:list={['project-card', 'reveal', delayClass, orientation]} {...(href ? { href } : {})}>
  <div class="media">
    <Image
      src={image}
      alt={alt}
      widths={[480, 720, 960, 1200]}
      sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 40vw"
      class="editorial"
    />
  </div>
  <div class="copy">
    <p class="meta"><span>{String(index + 1).padStart(2, '0')}</span>{category}{metal ? ` · ${metal}` : ''}</p>
    <Heading>{title}</Heading>
  </div>
</Tag>

<style>
  .project-card {
    display: grid;
    gap: 0.9rem;
    outline: 0;
  }

  a.project-card { cursor: pointer; }

  .media {
    position: relative;
    overflow: hidden;
    background: #000;
    aspect-ratio: 4 / 5;
  }

  .landscape .media { aspect-ratio: 16 / 10; }

  .editorial {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.04) saturate(1.04);
    transition: transform 0.7s var(--ease), filter 0.45s var(--ease);
  }

  a.project-card:hover .editorial,
  a.project-card:focus-visible .editorial {
    filter: contrast(1.08) saturate(1.1);
    transform: scale(1.045);
  }

  a.project-card:focus-visible {
    outline: 2px solid var(--gold-bright);
    outline-offset: 5px;
  }

  .copy {
    display: grid;
    gap: 0.3rem;
    padding-inline: 0.15rem;
  }

  h2,
  h3 {
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 550;
    letter-spacing: -.045em;
    line-height: 1.05;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: var(--gold);
    font: 500 0.62rem/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .meta span::after {
    content: '—';
    margin-left: 0.55rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial { transition: none; }
    a.project-card:hover .editorial,
    a.project-card:focus-visible .editorial { transform: none; }
  }
</style>
