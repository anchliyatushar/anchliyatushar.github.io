---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  videoSrc?: string;
  alt?: string;
  caption?: string;
  priority?: boolean;
  fullBleed?: boolean;
  monochrome?: boolean;
}

const { image, videoSrc, alt = '', caption, priority = false, fullBleed = false, monochrome = false } = Astro.props;
---

<figure class:list={['media-block', 'reveal', { 'full-bleed': fullBleed, monochrome }]}>
  {
    videoSrc ? (
      <div class="frame video-frame">
        <video
          src={videoSrc}
          poster={image?.src}
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
        ></video>
      </div>
    ) : image ? (
      <div class="frame">
        <Image
          src={image}
          alt={alt}
          widths={[640, 960, 1280, 1600]}
          sizes={fullBleed ? '100vw' : '(max-width: 900px) 100vw, 72rem'}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </div>
    ) : null
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media-block {
    margin: 0;
  }

  .frame {
    overflow: hidden;
    background: #000;
    border: 1px solid var(--line);
  }

  .full-bleed .frame {
    border-left: 0;
    border-right: 0;
    border-radius: 0;
  }

  .frame :global(img),
  .frame video {
    width: 100%;
    height: auto;
    vertical-align: middle;
    background: #000;
  }

  .video-frame video {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .monochrome .frame :global(img),
  .monochrome .frame video {
    filter: grayscale(1) contrast(1.1) brightness(.98);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .full-bleed figcaption {
    width: min(100% - 2 * var(--pad-x), var(--max));
    margin-inline: auto;
  }
</style>
